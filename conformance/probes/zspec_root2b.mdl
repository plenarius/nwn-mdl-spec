# nwn-mdl-spec conformance probe zspec_root2b (CC0-1.0)
# zspec_root2, then a node whose parent is in the first root's tree,
# declared after the second root.
newmodel zspec_root2b
setsupermodel zspec_root2b NULL
classification character
beginmodelgeom zspec_root2b
node dummy zspec_root2b
  parent NULL
endnode
node dummy first_kid
  parent zspec_root2b
  position 1 0 0
endnode
node dummy second
  parent NULL
  position 0 0 1
endnode
node dummy second_kid
  parent second
  position 2 0 0
endnode
node dummy late_kid
  parent first_kid
  position 3 0 0
endnode
endmodelgeom zspec_root2b
donemodel zspec_root2b
