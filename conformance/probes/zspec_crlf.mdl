# nwn-mdl-spec conformance probe zspec_crlf (CC0-1.0)
# The same model as zspec_dummy with CRLF line endings.
newmodel zspec_crlf
setsupermodel zspec_crlf NULL
classification Character
setanimationscale 2.5
beginmodelgeom zspec_crlf
node dummy zspec_crlf
  parent NULL
endnode
node dummy child_a
  parent zspec_crlf
  position 1 2 3
  orientation 0 0 1 1.5707963
  scale 2
  wirecolor 1 0 0
  inheritcolor 1
endnode
node dummy child_b
  parent child_a
  position -0.5 0.25 0
endnode
endmodelgeom zspec_crlf
donemodel zspec_crlf
